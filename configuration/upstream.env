# Where fish's source comes from. This repository is not a fork: the tree
# is fetched at the pinned ref and the patches in patches/ are applied on top.
#
# UPSTREAM_REF is a full commit sha on purpose. patches/ is context-sensitive,
# so a moving branch turns "the build broke" into "which of the last twenty
# upstream commits broke it". Bump it deliberately:
#
#     make bump-upstream REF=<sha>
#
UPSTREAM_REPO=https://github.com/fish-shell/fish-shell.git
UPSTREAM_REF=2a167f0b7cbd60fe234a246f7aa860f4df9216ce

# Name the CMake project ships as. `fish` on device, no rename needed.
PROGRAM=fish

# Upstream supports Rust 1.85+. Pin the compiler used locally and in CI.
RUST_TOOLCHAIN=1.85

# Deployment target. 15.0 is the floor of the jailbreaks this is packaged for.
MIN_IOS=15.0
ARCH=arm64

# RootHide rewrites path-related Mach-O imports after linking. Pin the build
# tool just like fish so release output does not depend on a moving branch.
SYMREDIRECT_REPO=https://github.com/roothide/libroothide.git
SYMREDIRECT_REF=7764c54759009272b4f2f23c18c62b21794fe6dd
