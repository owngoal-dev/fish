+#[cfg(target_os = "ios")]
+pub(crate) fn shebang_interpreter(path: &CStr) -> Option<(CString, Option<CString>)> {
+    if unsafe { libc::access(path.as_ptr(), libc::X_OK) } != 0 {
+        return None;
+    }
+
+    let mut file = std::fs::File::open(std::ffi::OsStr::from_bytes(path.to_bytes())).ok()?;
+    let mode = file.metadata().ok()?.mode();
+    if mode & u32::from(libc::S_ISUID | libc::S_ISGID) != 0 {
+        return None;
+    }
+
+    let mut buf = [0; 256];
+    let len = file.read(&mut buf).ok()?;
+    if !buf[..len].starts_with(b"#!") {
+        return None;
+    }
+    let newline = buf[..len].iter().position(|&byte| byte == b'\n')?;
+    let line = buf[2..newline].trim_ascii();
+    let split = line
+        .iter()
+        .position(|byte| byte.is_ascii_whitespace())
+        .unwrap_or(line.len());
+    let interpreter = &line[..split];
+    if !interpreter.starts_with(b"/") {
+        return None;
+    }
+    let argument = line[split..].trim_ascii();
+    Some((
+        CString::new(interpreter).ok()?,
+        if argument.is_empty() {
+            None
+        } else {
+            Some(CString::new(argument).ok()?)
+        },
+    ))
+}
