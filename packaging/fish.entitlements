<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fish is an interactive shell. It needs to remain outside an app container
  and access both bootstrap files and user-selected paths.

  platform-application
      Marks the shell as a platform binary.

  com.apple.private.security.no-sandbox
      Shell commands must not be confined to an app sandbox.

  com.apple.private.security.container-required = false
      Keeps HOME at the invoking user's real home. Absence is not equivalent;
      the switch must be explicitly false.

  RootHide also requires AppBundles and AppDataContainers storage access for
  command-line tools that cross its virtual-root boundary.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
</dict>
</plist>
